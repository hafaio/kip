rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Friendship is bijective — both edges are written — so one exists() answers it.
    function isFriendOf(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(ownerId)/friends/$(request.auth.uid));
    }

    // Pinned because the holder of this copy may not be able to read your profile,
    // so they can't check it themselves.
    function edgeMatchesWriter(edge) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return edge.get('displayName', '') == profile.get('displayName', '')
          && edge.get('username', '') == profile.get('username', '')
          && edge.get('photoURL', null) == profile.get('photoURL', null);
    }

    // A pointer, not a grant: the booking is re-read here, so a cancelled stay
    // makes it inert with nothing to tear down. It has to be a pointer because
    // "is there a booking joining these two?" is a query, and rules can't query.
    function sharesStayWith(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/knownBy/$(request.auth.uid))
        && stayPermitsSight(
             get(/databases/$(database)/documents/users/$(userId)/knownBy/$(request.auth.uid)).data.get('bookingId', ''),
             userId,
             request.auth.uid
           );
    }

    function listingOwner(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId;
    }

    // The prefs doc is private to its owner, which is no obstacle: a rule's get()
    // is not a client read. Absent means on, matching the client default — a rule
    // quietly disagreeing with the switch Settings draws is worse than either
    // answer on its own.
    function guestSharesStays(guestId) {
      let prefs = /databases/$(database)/documents/users/$(guestId)/settings/prefs;
      return isFriendOf(guestId)
        && (!exists(prefs) || get(prefs).data.get('shareStaysWithFriends', true) == true);
    }

    // The null guard has to test null, not '': an OPEN slot carries bookingId
    // PRESENT and null (the create rule pins it that way), and get(k, default)
    // substitutes only for an ABSENT key. Guarding on '' let null through to
    // path interpolation, which is a Null value error — denying by throwing
    // rather than by answering, so no clause after this one would ever run.
    function slotHolder(bookingId) {
      return bookingId != null && exists(/databases/$(database)/documents/bookings/$(bookingId))
        ? get(/databases/$(database)/documents/bookings/$(bookingId)).data.guestId
        : '';
    }

    // Same pointer shape as sharesStayWith — inert once the booking isn't CONFIRMED.
    function guestOfListing(listingId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/listings/$(listingId)/guests/$(request.auth.uid))
        && bookingBacksGuest(listingId, get(/databases/$(database)/documents/listings/$(listingId)/guests/$(request.auth.uid)).data.get('bookingId', ''));
    }

    function bookingBacksGuest(listingId, bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId))
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'CONFIRMED'
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.guestId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.listingId == listingId;
    }

    // A read request has no body, so a visitor proves they know a token by WRITING
    // a grant under it; reads then compare that against whichever token the
    // document currently sits under, which is why revoking is instant.
    function portalGrant(token) {
      return token != null
        && request.auth != null
        && exists(/databases/$(database)/documents/portals/$(token))
        && exists(/databases/$(database)/documents/portals/$(token)/grants/$(request.auth.uid));
    }

    // OPEN as well as autoAccept, or a crafted client could mint a second
    // CONFIRMED booking onto a slot someone else already holds.
    function windowInstantlyBookable(listingId, windowId) {
      let window = get(/databases/$(database)/documents/listings/$(listingId)/windows/$(windowId)).data;
      return window.autoAccept == true && window.status == 'OPEN';
    }

    // getAfter requires the slot flip to travel with the booking. Without it a
    // confirm is a lone booking write, the slot stays OPEN, and the host can
    // promise one slot to any number of guests.
    function slotHandedTo(booking, bookingId) {
      let after = getAfter(/databases/$(database)/documents/listings/$(booking.listingId)/windows/$(booking.windowId)).data;
      return after.status == 'BOOKED' && after.get('bookingId', '') == bookingId;
    }

    // The mirror image, checked from the slot's side: the booking travels with
    // the flip, so it is not committed yet and only getAfter can see it.
    function bookingArrivingWith(bookingId, listingId, windowId) {
      return bookingId != ''
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.guestId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'CONFIRMED'
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.listingId == listingId
        && getAfter(/databases/$(database)/documents/bookings/$(bookingId)).data.windowId == windowId;
    }

    // Called from create AND update: a request must not outlive the route that
    // put it there. The stay route is the only one open to a share-link guest and
    // their host, who are neither searchable to nor linked by each other.
    function requestRouteOpen(request_) {
      return get(/databases/$(database)/documents/users/$(request_.to)).data.get('searchable', false) == true
        || (request_.get('portalId', null) != null
            && exists(/databases/$(database)/documents/portals/$(request_.portalId))
            && get(/databases/$(database)/documents/portals/$(request_.portalId)).data.ownerId == request_.to)
        || bookingJoins(request_.get('bookingId', ''), request_.from, request_.to);
    }

    function bookingJoins(bookingId, first, second) {
      return bookingId != ''
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'CONFIRMED'
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.ownerId in [first, second]
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.guestId in [first, second]
        && first != second;
    }

    function staySightDays() { return 60; }

    // REQUESTED is one-way — the HOST may look up the GUEST they're deciding on,
    // but being asked is not consent to be looked up.
    function stayPermitsSight(bookingId, subjectUid, readerUid) {
      let stay = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return bookingId != ''
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && subjectUid != readerUid
        && (
          (stay.status == 'CONFIRMED'
            && stay.ownerId in [subjectUid, readerUid]
            && stay.guestId in [subjectUid, readerUid]
            && endedWithin(stay.end, staySightDays()))
          || (stay.status == 'REQUESTED'
              && stay.ownerId == readerUid
              && stay.guestId == subjectUid)
        );
    }

    // Used at both ends of a stay's life — asking and confirming — since the slot
    // sits OPEN in between and the host may still move it.
    function bookingMatchesOpenSlot(booking) {
      let window = get(/databases/$(database)/documents/listings/$(booking.listingId)/windows/$(booking.windowId)).data;
      return window.status == 'OPEN'
          && window.start == booking.start
          && window.end == booking.end
          && stillCurrent(window.end);
    }

    // The boundary is YESTERDAY on purpose: request.time is UTC while the client
    // compares local dates, so anyone west of UTC would be refused an edit the UI
    // had just offered them.
    function stillCurrent(iso) {
      let parts = iso.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          >= timestamp.date(request.time.year(), request.time.month(), request.time.day()) - duration.value(1, 'd');
    }

    // Nothing ever writes to a booking when it ends, so there is no transition to
    // hook a decaying grant to — the rule reads the date itself.
    function endedWithin(iso, days) {
      let parts = iso.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          >= timestamp.date(request.time.year(), request.time.month(), request.time.day())
             - duration.value(days, 'd');
    }

    function portalCoversWindow(listingId, windowId) {
      return portalGrant(get(/databases/$(database)/documents/listings/$(listingId)/windows/$(windowId)).data.get('publicPortalId', null))
          || portalGrant(get(/databases/$(database)/documents/listings/$(listingId)).data.get('publicPortalId', null))
          || portalGrant(get(/databases/$(database)/documents/users/$(listingOwner(listingId))/settings/prefs).data.get('profilePortalId', null));
    }

    // No list, so a private account is indistinguishable from one that never
    // existed — even to someone holding your uid from a friendship you ended.
    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId
            || resource.data.get('searchable', false) == true
            || isFriendOf(userId)
            || sharesStayWith(userId));
      allow list: if false;
      // A displayed handle must resolve to a registry entry you own, and being
      // searchable requires having one. Email is simply never written here.
      allow write: if isSignedIn() && request.auth.uid == userId
        && (!('username' in request.resource.data)
            || get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId)
        && (request.resource.data.get('searchable', false) == false
            || request.resource.data.get('username', '') != '');

      match /settings/{doc} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Saved searches are private notes about what you're looking for, read
      // only by their owner's client. Nothing else resolves them, so there is
      // nothing here to pin.
      match /searches/{searchId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /knownBy/{readerUid} {
        allow get: if isSignedIn()
          && (request.auth.uid == readerUid || request.auth.uid == userId);
        allow list: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == readerUid
          && request.resource.data.keys().hasOnly(['bookingId'])
          && stayPermitsSight(request.resource.data.bookingId, userId, readerUid);
        allow delete: if isSignedIn()
          && (request.auth.uid == readerUid || request.auth.uid == userId);
      }

      match /friends/{friendId} {
        allow read: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
        // The second clause is the accept step: the accepter writes the sender's
        // edge, authorised by the pending request named `${sender}_${accepter}`.
        allow create: if isSignedIn()
          && (request.auth.uid == userId
              || (request.auth.uid == friendId
                  && exists(/databases/$(database)/documents/connectRequests/$(userId + '_' + friendId))
                  && edgeMatchesWriter(request.resource.data)));
        // Heals a rename in someone else's list. Rules read committed state, so
        // the profile write has to land first (see updateDisplayName). `username`
        // is listed because an edge written before you claimed one holds '' and
        // would otherwise fail edgeMatchesWriter forever.
        allow update: if isSignedIn()
          && request.auth.uid == friendId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'username'])
          && edgeMatchesWriter(request.resource.data);
        allow delete: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // Uniqueness is structural: claiming a taken handle falls to `update`, which
    // only its owner passes. There is deliberately NO delete — a permanent handle
    // is what makes going private reversible rather than a chance to be squatted.
    match /usernames/{handle} {
      allow get: if isSignedIn();
      allow list: if false;
      // Never anonymous: those accounts are reaped after 30 days and a handle is
      // permanent, so one script could take every good name for a dead uid.
      allow create: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && handle.matches('^[a-z][a-z0-9_]{2,19}$')
        && !(handle in ['admin', 'kip', 'support', 'help', 'root', 'system', 'about', 'settings']);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if false;
    }

    // "Let's be friends", nothing else — asking to stay is a REQUESTED booking.
    match /connectRequests/{requestId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      // The sender's name and handle go into the recipient's inbox and their
      // email, and the recipient can't read the sender's profile to check them.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.from
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromName
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '')
        && request.resource.data.fromUsername
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '')
        && requestRouteOpen(request.resource.data);
      // Re-asking overwrites the same doc, so it must face the same checks —
      // otherwise a revoked link's `portalId` stays rewritable.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.from
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.fromName
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '')
        && request.resource.data.fromUsername
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '')
        && requestRouteOpen(request.resource.data);
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    match /listings/{listingId} {
      // Clause ORDER is load-bearing: 20 document lookups per query, repeats of
      // one path counted once, so the checks that cover a whole query in one
      // lookup go first and the per-document ones last. A slot grant is
      // deliberately absent — sharing dates doesn't hand over the room.
      allow read: if request.auth.uid == resource.data.ownerId
        || isFriendOf(resource.data.ownerId)
        || portalGrant(get(/databases/$(database)/documents/users/$(resource.data.ownerId)/settings/prefs).data.get('profilePortalId', null))
        || portalGrant(resource.data.get('publicPortalId', null))
        || guestOfListing(listingId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      // Self-issued by the guest, because neither confirm path can write it:
      // rules see committed state, so the booking isn't CONFIRMED yet inside
      // either commit. Safe because it grants nothing on its own.
      match /guests/{guestUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == guestUid || request.auth.uid == listingOwner(listingId));
        // Update on the same terms as create: the client re-claims on every load,
        // so every claim after the first is a rewrite.
        allow create, update: if isSignedIn()
          && request.auth.uid == guestUid
          && request.resource.data.keys().hasOnly(['bookingId'])
          && bookingBacksGuest(listingId, request.resource.data.bookingId);
        allow delete: if isSignedIn()
          && (request.auth.uid == guestUid || request.auth.uid == listingOwner(listingId));
      }

      match /windows/{windowId} {
        // Three separate grant checks because all three links can cover one
        // window at once and a rule compares one value at a time. Same ordering
        // discipline as the listing rule. The holder check stands alone (a grant
        // lapses long before a stay does) and goes last because, like the slot's
        // own grant above it, it costs a lookup per document rather than one for
        // the whole query.
        allow read: if request.auth.uid == listingOwner(listingId)
          || isFriendOf(listingOwner(listingId))
          || portalGrant(get(/databases/$(database)/documents/listings/$(listingId)).data.get('publicPortalId', null))
          || portalGrant(get(/databases/$(database)/documents/users/$(listingOwner(listingId))/settings/prefs).data.get('profilePortalId', null))
          || portalGrant(resource.data.get('publicPortalId', null))
          || slotHolder(resource.data.get('bookingId', null)) == request.auth.uid;
        // Born free, or an owner could create one already BOOKED naming anyone as
        // holder and hand them a standing read of it.
        allow create: if isSignedIn()
          && request.auth.uid == listingOwner(listingId)
          && request.resource.data.status == 'OPEN'
          && request.resource.data.get('bookingId', null) == null;
        allow delete: if isSignedIn() && request.auth.uid == listingOwner(listingId);
        allow update: if isSignedIn()
          && ((request.auth.uid == listingOwner(listingId)
                  // Dates freeze once BOOKED (a stay is an agreement about
                  // specific nights) and once past (reviving them would revive
                  // the stale asks pointing at them). Both guards read the
                  // EXISTING status, so the OPEN<->BOOKED flips still pass.
                  && (resource.data.status != 'BOOKED'
                      || (request.resource.data.start == resource.data.start
                          && request.resource.data.end == resource.data.end))
                  && (stillCurrent(resource.data.end)
                      || (request.resource.data.start == resource.data.start
                          && request.resource.data.end == resource.data.end)))
              // A friend claims an auto-accept slot. hasOnly pins every other
              // field, including ones added later; enumerated equality didn't.
              || (isFriendOf(listingOwner(listingId))
                  && resource.data.autoAccept == true
                  && resource.data.status == 'OPEN'
                  && request.resource.data.status == 'BOOKED'
                  && bookingArrivingWith(request.resource.data.get('bookingId', ''), listingId, windowId)
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookingId']))
              // The booker releases it on cancel.
              || (slotHolder(resource.data.get('bookingId', null)) == request.auth.uid
                  && resource.data.status == 'BOOKED'
                  && request.resource.data.status == 'OPEN'
                  && request.resource.data.get('bookingId', null) == null
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'bookingId'])));
      }
    }

    match /bookings/{bookingId} {
      // The two parties, plus the guest's own friends when the guest opted in —
      // which is what makes a held slot renderable at all, since the holder's
      // identity now lives only here. Both party checks come first, so the
      // trips and incoming queries never pay for the two extra lookups.
      // CONFIRMED only for the third: a stay is what's being shared, and where
      // someone merely ASKED to go — or was turned down — is nobody else's.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.guestId
            || request.auth.uid == resource.data.ownerId
            || (resource.data.status == 'CONFIRMED'
                && guestSharesStays(resource.data.guestId)));
      // One way to ask, whoever is asking; only the authorisation differs. A
      // share-link visitor can never instant-book — a link is not friendship.
      // No names are carried, so there is nothing here to pin but the stamps.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.guestId
        && request.resource.data.ownerId == listingOwner(request.resource.data.listingId)
        && bookingMatchesOpenSlot(request.resource.data)
        && request.resource.data.get('cancelledBy', null) == null
        && request.resource.data.get('cancelReason', null) == null
        && (
          (isFriendOf(request.resource.data.ownerId)
            && (request.resource.data.status == 'REQUESTED'
                || (request.resource.data.status == 'CONFIRMED'
                    && windowInstantlyBookable(request.resource.data.listingId, request.resource.data.windowId)
                    && slotHandedTo(request.resource.data, bookingId))))
          || (request.resource.data.status == 'REQUESTED'
              && portalCoversWindow(request.resource.data.listingId, request.resource.data.windowId))
        );
      // The transition graph, not just the fields: CANCELLED is an ending,
      // CONFIRMED comes only from REQUESTED, and REQUESTED is a birth state
      // nothing returns to. Cancelling stamps who and why, and you may only stamp
      // yourself — a trigger can't see who wrote, and the email depends on it.
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.guestId || request.auth.uid == resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelReason'])
        && resource.data.status != 'CANCELLED'
        && (request.resource.data.status != 'CONFIRMED'
            || resource.data.status == 'REQUESTED')
        && request.resource.data.status != 'REQUESTED'
        && (request.resource.data.get('cancelledBy', null) == null
            || request.resource.data.cancelledBy == request.auth.uid)
        && (request.auth.uid == resource.data.ownerId
            || request.resource.data.status == 'CANCELLED')
        && (request.resource.data.status != 'CONFIRMED'
            || (bookingMatchesOpenSlot(resource.data)
                && slotHandedTo(resource.data, bookingId)));
      // A hide, not a delete: one document is the record for both parties. Each
      // may add only their own uid, so the client must arrayUnion.
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.guestId || request.auth.uid == resource.data.ownerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy'])
        && resource.data.status == 'CANCELLED'
        && request.resource.data.hiddenBy.hasOnly(resource.data.get('hiddenBy', []).concat([request.auth.uid]))
        && request.resource.data.hiddenBy.hasAll(resource.data.get('hiddenBy', []));
      // Terminal: guest access is a pointer AT one of these, so deleting would
      // strand it. Ending a stay means CANCELLED.
      allow delete: if false;
    }

    // Capability URL: the id is the secret, so world-readable by id and never
    // enumerable. Revoke = delete, regenerate = new uuid, both instant.
    match /portals/{portalId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      match /grants/{accountId} {
        allow get: if isSignedIn() && request.auth.uid == accountId;
        allow list: if false;
        allow create, update: if isSignedIn()
          && request.auth.uid == accountId
          && exists(/databases/$(database)/documents/portals/$(portalId));
        allow delete: if isSignedIn() && request.auth.uid == accountId;
      }
    }

    // There is deliberately no `mail` collection: a client-written queue could
    // gate who you write to but never what, and couldn't express a connect
    // request at all. Email is sent by triggers on the events themselves.
  }
}
