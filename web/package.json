{
  "private": true,
  "name": "kip-web",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "export": "next build",
    "fmt": "biome format --write",
    "lint": "tsc && biome check && tsc --noEmit -p ../functions",
    "test": "bun test --path-ignore-patterns '**/rules.test.ts'",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-kip-rules 'bun test tests/rules.test.ts'"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "geofire-common": "^6.0.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "firebase-admin": "^14.2.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
