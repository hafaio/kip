    "@tailwindcss/postcss": "^4.1.13",
    "@types/bun": "^1.3.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.12",
    "autoprefixer": "^10.4.21",
